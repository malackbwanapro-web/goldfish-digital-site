  "engineeringNotes": {
    "navigation": {
      "headerLayout": "Strict flexbox space-between: BrandMark left | Nav center | CTA right",
      "collapseBreakpoint": "1024px — center nav → hamburger menu",
      "closingCTA": "Build as single reusable global component used on Home, Services, Service pages, Portfolio"
    },
    "filteringLogic": {
      "pages": ["Portfolio", "Insights"],
      "requirement": "Zero-reload transitions — instant JS filter states or React/Vue state",
      "emptyState": "'No active deployments in this category yet. Contact us to build yours.' — centered text block"
    },
    "imageSizing": {
      "rule": "All graphic placeholders must use CSS aspect-ratio property: aspect-ratio: 16/9; object-fit: cover;",
      "reason": "Prevents layout warp when copy lengths vary"
    },
    "typography": {
      "heroH1": "Must use CSS clamp() for fluid scaling — prevents 1-letter wrapping on mobile",
      "heroH1Range": "clamp(36px, 6vw, 60px)"
    },
    "contactForm": {
      "mobileOrder": "Path A (Intake Form) stacks ABOVE Path B (Calendar) on mobile",
      "calendarFallback": "Explicit height/width fallback on calendar container to prevent CLS during Calendly/HubSpot load"
    }
  }
