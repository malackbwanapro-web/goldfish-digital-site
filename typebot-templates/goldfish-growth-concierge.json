{
  "version": "6.1",
  "name": "Goldfish Growth Concierge",
  "events": [
    {
      "id": "event-start-gfm",
      "outgoingEdgeId": "edge-start-to-welcome",
      "graphCoordinates": { "x": 0, "y": 0 },
      "type": "start"
    }
  ],
  "groups": [
    {
      "id": "group-welcome",
      "title": "Welcome & Qualification",
      "graphCoordinates": { "x": 0, "y": 140 },
      "blocks": [
        {
          "id": "block-welcome-1",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  { "text": "👋 Jambo! Welcome to " },
                  { "bold": true, "text": "Goldfish Marketing" },
                  { "text": ". I'm your digital growth concierge." }
                ]
              }
            ]
          }
        },
        {
          "id": "block-welcome-2",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  { "text": "Which category best describes your business in Kenya?" }
                ]
              }
            ]
          }
        },
        {
          "id": "block-industry-choice",
          "outgoingEdgeId": "edge-welcome-to-name",
          "type": "choice input",
          "options": {
            "variableId": "var-industry"
          },
          "items": [
            {
              "id": "item-hospitality",
              "content": "🏨 Luxury Villa, Resort or Cottages"
            },
            {
              "id": "item-dining",
              "content": "🍽️ Restaurant, Pub or Nightlife Venue"
            },
            {
              "id": "item-safari",
              "content": "🦁 Safari Lodge or Tour Operator"
            },
            {
              "id": "item-sme",
              "content": "🏢 High-Growth SME / Professional Brand"
            },
            {
              "id": "item-direct",
              "content": "💬 Speak to Founder Malack Bwana directly"
            }
          ]
        }
      ]
    },
    {
      "id": "group-contact-name",
      "title": "Contact Name",
      "graphCoordinates": { "x": 340, "y": 140 },
      "blocks": [
        {
          "id": "block-ask-name",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  { "text": "Great! What is your name and business or property name?" }
                ]
              }
            ]
          }
        },
        {
          "id": "block-input-name",
          "outgoingEdgeId": "edge-name-to-phone",
          "type": "text input",
          "options": {
            "labels": {
              "placeholder": "e.g. David Miller (Diani Beachfront Villas)"
            },
            "variableId": "var-name"
          }
        }
      ]
    },
    {
      "id": "group-contact-phone",
      "title": "Phone & WhatsApp",
      "graphCoordinates": { "x": 680, "y": 140 },
      "blocks": [
        {
          "id": "block-ask-phone",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  { "text": "Nice to meet you, " },
                  { "bold": true, "text": "{{Name}}" },
                  { "text": "! What is the best WhatsApp number or phone to reach you on?" }
                ]
              }
            ]
          }
        },
        {
          "id": "block-input-phone",
          "outgoingEdgeId": "edge-phone-to-timeline",
          "type": "phone number input",
          "options": {
            "labels": {
              "placeholder": "+254 711 404 755"
            },
            "variableId": "var-phone"
          }
        }
      ]
    },
    {
      "id": "group-timeline",
      "title": "Timeline & Scope",
      "graphCoordinates": { "x": 1020, "y": 140 },
      "blocks": [
        {
          "id": "block-ask-timeline",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  { "text": "What is your target launch timeline?" }
                ]
              }
            ]
          }
        },
        {
          "id": "block-choice-timeline",
          "outgoingEdgeId": "edge-timeline-to-handoff",
          "type": "choice input",
          "options": {
            "variableId": "var-timeline"
          },
          "items": [
            {
              "id": "time-urgent",
              "content": "⚡ Urgent Sprint (Under 14 Days)"
            },
            {
              "id": "time-standard",
              "content": "🎯 Standard Delivery (14–21 Days)"
            },
            {
              "id": "time-flexible",
              "content": "🌊 Flexible / Multi-Phase Architecture"
            }
          ]
        }
      ]
    },
    {
      "id": "group-handoff",
      "title": "Completion & WhatsApp",
      "graphCoordinates": { "x": 1360, "y": 140 },
      "blocks": [
        {
          "id": "block-summary",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  { "text": "Perfect! We have compiled your project brief for " },
                  { "bold": true, "text": "{{Industry}}" },
                  { "text": " (Target: {{Timeline}})." }
                ]
              }
            ]
          }
        },
        {
          "id": "block-webhook",
          "type": "webhook",
          "options": {
            "url": "https://www.goldfishmarketing.co.ke/api/leads",
            "method": "POST",
            "headers": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "idempotency-key", "value": "typebot-concierge-lead-session" }
            ],
            "body": "{\n  \"intent\": \"typebot_assistant\",\n  \"name\": \"{{Name}}\",\n  \"phone\": \"{{Phone}}\",\n  \"serviceInterest\": \"{{Industry}} ({{Timeline}})\",\n  \"message\": \"Captured via Goldfish Growth Concierge Chatbot\"\n}"
          }
        },
        {
          "id": "block-final-cta",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  { "text": "Founder Malack Bwana is available to discuss your specifications directly on WhatsApp:" }
                ]
              }
            ]
          }
        },
        {
          "id": "block-redirect-whatsapp",
          "type": "redirect",
          "options": {
            "url": "https://wa.me/254711404755?text=Hi%20Malack,%20I%20just%20completed%20the%20digital%20scope%20concierge%20on%20your%20website%20for%20{{Name}}%20({{Industry}}).",
            "isNewTab": true
          }
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "edge-start-to-welcome",
      "from": { "eventId": "event-start-gfm" },
      "to": { "groupId": "group-welcome" }
    },
    {
      "id": "edge-welcome-to-name",
      "from": { "blockId": "block-industry-choice" },
      "to": { "groupId": "group-contact-name" }
    },
    {
      "id": "edge-name-to-phone",
      "from": { "blockId": "block-input-name" },
      "to": { "groupId": "group-contact-phone" }
    },
    {
      "id": "edge-phone-to-timeline",
      "from": { "blockId": "block-input-phone" },
      "to": { "groupId": "group-timeline" }
    },
    {
      "id": "edge-timeline-to-handoff",
      "from": { "blockId": "block-choice-timeline" },
      "to": { "groupId": "group-handoff" }
    }
  ],
  "variables": [
    { "id": "var-industry", "name": "Industry", "isSessionVariable": true },
    { "id": "var-name", "name": "Name", "isSessionVariable": true },
    { "id": "var-phone", "name": "Phone", "isSessionVariable": true },
    { "id": "var-timeline", "name": "Timeline", "isSessionVariable": true }
  ],
  "theme": {
    "general": {
      "font": "Inter",
      "background": { "type": "Color", "content": "#0D0D0D" }
    },
    "chat": {
      "hostBubbles": {
        "backgroundColor": "#1A1A1A",
        "color": "#FFFFFF"
      },
      "guestBubbles": {
        "backgroundColor": "#D4A017",
        "color": "#0D0D0D"
      },
      "buttons": {
        "backgroundColor": "#D4A017",
        "color": "#0D0D0D"
      },
      "inputs": {
        "backgroundColor": "#141414",
        "color": "#FFFFFF",
        "placeholderColor": "#737373"
      }
    }
  },
  "settings": {
    "general": {
      "isBrandingEnabled": false
    }
  }
}
