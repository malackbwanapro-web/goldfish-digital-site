# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML Meta Tag Verification Code
# Extract code from: <meta name="google-site-verification" content="YOUR_VERIFICATION_CODE_HERE" />
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Server-only mail configuration. Never prefix this key with NEXT_PUBLIC_.
# Set in Vercel Production and Preview as appropriate; do not commit real values.
RESEND_API_KEY=
# Verify leads@goldfishmarketing.co.ke in Resend before expecting delivery.
# A 202 API response is provider acceptance, not confirmation of inbox delivery.
